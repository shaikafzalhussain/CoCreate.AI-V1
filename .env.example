# OpenRouter server-side configuration; never use the VITE_ prefix.
# Get keys from https://openrouter.ai/keys, then set them in .env.local or Vercel.
# Supabase Auth (public project values; enable Email auth in Supabase).
# Apply supabase/migrations/20261018_create_user_profiles.sql in your Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-side Supabase values used to verify logged-in API requests
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# CoCreate.AI V2 server-only keys (do not use the VITE_ prefix)
OPENROUTER_API_KEY=your_chat_key_here
OPENROUTER_REFINE_API_KEY=your_prompt_refinement_key_here

# For V2 API requests, use Vercel environment variables or `vercel dev` locally.
# Never commit real API keys.
